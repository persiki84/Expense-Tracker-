import json
import os
import tkinter as tk
from datetime import datetime
from tkinter import messagebox, ttk

DATA_FILE = "expenses.json"


class ExpenseTracker:

    def __init__(self, root):
        self.root = root
        self.root.title("Expense Tracker")
        self.root.geometry("800x600")

        self.expenses = self.load_data()

        self.create_widgets()
        self.update_table(self.expenses)

    def load_data(self):
        if os.path.exists(DATA_FILE):
            try:
                with open(DATA_FILE, "r", encoding="utf-8") as f:
                    return json.load(f)
            except json.JSONDecodeError:
                return []
        return []

    def save_data(self):
        with open(DATA_FILE, "w", encoding="utf-8") as f:
            json.dump(self.expenses, f, ensure_ascii=False, indent=4)

    def create_widgets(self):
        # --- Блок ввода ---
        input_frame = tk.LabelFrame(self.root, text="Добавить расход", padding=10)
        input_frame.pack(fill="x", padx=10, pady=5)

        tk.Label(input_frame, text="Сумма:").grid(row=0, column=0, sticky="w")
        self.amount_entry = tk.Entry(input_frame)
        self.amount_entry.grid(row=0, column=1, padx=5, pady=5)

        tk.Label(input_frame, text="Категория:").grid(
            row=0, column=2, sticky="w"
        )
        self.category_cb = ttk.Combobox(
            input_frame, values=["Еда", "Транспорт", "Развлечения", "Другое"]
        )
        self.category_cb.grid(row=0, column=3, padx=5, pady=5)
        self.category_cb.current(0)

        tk.Label(input_frame, text="Дата (ДД.ММ.ГГГГ):").grid(
            row=0, column=4, sticky="w"
        )
        self.date_entry = tk.Entry(input_frame)
        self.date_entry.grid(row=0, column=5, padx=5, pady=5)
        self.date_entry.insert(0, datetime.now().strftime("%d.%m.%Y"))

        add_btn = tk.Button(
            input_frame, text="Добавить расход", command=self.add_expense
        )
        add_btn.grid(row=0, column=6, padx=10, pady=5)

        # --- Блок фильтрации ---
        filter_frame = tk.LabelFrame(
            self.root, text="Фильтры и Анализ", padding=10
        )
        filter_frame.pack(fill="x", padx=10, pady=5)

        tk.Label(filter_frame, text="Категория:").grid(row=0, column=0)
        self.f_category_cb = ttk.Combobox(
            filter_frame,
            values=["Все", "Еда", "Транспорт", "Развлечения", "Другое"],
        )
        self.f_category_cb.grid(row=0, column=1, padx=5)
        self.f_category_cb.current(0)

        tk.Label(filter_frame, text="С даты:").grid(row=0, column=2)
        self.f_start_date = tk.Entry(filter_frame, width=10)
        self.f_start_date.grid(row=0, column=3, padx=5)

        tk.Label(filter_frame, text="По дату:").grid(row=0, column=4)
        self.f_end_date = tk.Entry(filter_frame, width=10)
        self.f_end_date.grid(row=0, column=5, padx=5)

        filter_btn = tk.Button(
            filter_frame, text="Применить", command=self.apply_filter
        )
        filter_btn.grid(row=0, column=6, padx=5)

        reset_btn = tk.Button(
            filter_frame, text="Сбросить", command=self.reset_filter
        )
        reset_btn.grid(row=0, column=7, padx=5)

        # --- Таблица ---
        self.tree = ttk.Treeview(
            self.root, columns=("Сумма", "Категория", "Дата"), show="headings"
        )
        self.tree.heading("Сумма", text="Сумма")
        self.tree.heading("Категория", text="Категория")
        self.tree.heading("Дата", text="Дата")
        self.tree.pack(fill="both", expand=True, padx=10, pady=5)

        # --- Итоговая сумма ---
        self.total_label = tk.Label(
            self.root, text="Итого: 0.00", font=("Arial", 14, "bold")
        )
        self.total_label.pack(pady=10)

    def validate_date(self, date_str):
        try:
            datetime.strptime(date_str, "%d.%m.%Y")
            return True
        except ValueError:
            return False

    def add_expense(self):
        amount_str = self.amount_entry.get().strip()
        category = self.category_cb.get().strip()
        date_str = self.date_entry.get().strip()

        try:
            amount = float(amount_str)
            if amount <= 0:
                raise ValueError
        except ValueError:
            messagebox.showerror(
                "Ошибка", "Сумма должна быть положительным числом!"
            )
            return

        if not category:
            messagebox.showerror("Ошибка", "Выберите или введите категорию!")
            return

        if not self.validate_date(date_str):
            messagebox.showerror(
                "Ошибка", "Неверный формат даты! Используйте ДД.ММ.ГГГГ"
            )
            return

        new_expense = {"amount": amount, "category": category, "date": date_str}

        self.expenses.append(new_expense)
        self.save_data()
        self.reset_filter()
        self.amount_entry.delete(0, tk.END)

    def update_table(self, data_list):
        for item in self.tree.get_children():
            self.tree.delete(item)

        total = 0.0
        # Сортировка по дате для отображения
        try:
            sorted_list = sorted(
                data_list,
                key=lambda x: datetime.strptime(x["date"], "%d.%m.%Y"),
                reverse=True,
            )
        except ValueError:
            sorted_list = data_list

        for exp in sorted_list:
            self.tree.insert(
                "",
                tk.END,
                values=(f"{exp['amount']:.2f}", exp["category"], exp["date"]),
            )
            total += exp["amount"]

        self.total_label.config(text=f"Итого за период: {total:.2f}")

    def apply_filter(self):
        category_filter = self.f_category_cb.get()
        start_str = self.f_start_date.get().strip()
        end_str = self.f_end_date.get().strip()

        filtered = self.expenses

        if category_filter != "Все":
            filtered = [
                e for e in filtered if e["category"] == category_filter
            ]

        if start_str:
            if not self.validate_date(start_str):
                messagebox.showerror(
                    "Ошибка", "Неверный формат начальной даты!"
                )
                return
            start_date = datetime.strptime(start_str, "%d.%m.%Y")
            filtered = [
                e
                for e in filtered
                if datetime.strptime(e["date"], "%d.%m.%Y") >= start_date
            ]

        if end_str:
            if not self.validate_date(end_str):
                messagebox.showerror(
                    "Ошибка", "Неверный формат конечной даты!"
                )
                return
            end_date = datetime.strptime(end_str, "%d.%m.%Y")
            filtered = [
                e
                for e in filtered
                if datetime.strptime(e["date"], "%d.%m.%Y") <= end_date
            ]

        self.update_table(filtered)

    def reset_filter(self):
        self.f_category_cb.current(0)
        self.f_start_date.delete(0, tk.END)
        self.f_end_date.delete(0, tk.END)
        self.update_table(self.expenses)


if __name__ == "__main__":
    root = tk.Tk()
    app = ExpenseTracker(root)
    root.mainloop()
